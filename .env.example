# Backend
DATABASE_URL=sqlite:///./trinetra.db
DB_PATH=../trinetra.db
OSRM_BASE_URL=https://router.project-osrm.org
FRONTEND_ORIGIN=http://localhost:5173

# Dispatch engine tuning
SURGE_THRESHOLD=1.5
MIN_SHORTAGE=10
STALE_LOCATION_MINUTES=30
MIN_USEFUL_SEATS=10
MIN_SOURCE_CAPACITY=20

# Scoring weights (must sum to 1.0)
W_URGENCY=0.35
W_CAPACITY=0.30
W_ETA=0.25
W_IMPACT=0.10

# Frontend
VITE_API_BASE_URL=http://localhost:8000

